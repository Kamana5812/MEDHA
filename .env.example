# ============================================================
# MEDHA Contact API — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env (it is already in .gitignore).
# ============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- SMTP credentials ----------
# Gmail example (requires a 16-char App Password, NOT your login password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=abcdefghijklmnop

# Other common providers:
#   Brevo    -> smtp-relay.brevo.com : 587
#   Mailtrap -> sandbox.smtp.mailtrap.io : 2525   (safe for testing)
#   Zoho     -> smtp.zoho.in : 465 (SMTP_SECURE=true)

# ---------- Mail routing ----------
MAIL_TO=hello@medha-education.com
MAIL_FROM="MEDHA Website" <your.address@gmail.com>

# ---------- Security ----------
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5500,https://medha.vercel.app

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5